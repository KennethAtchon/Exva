{
  "name": "exva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "dev:debug": "EXVA_LOG_LEVEL=debug electron-forge start",
    "dev:rebuild-db": "EXVA_DB_REBUILD_FROM_SCRATCH=true electron-forge start",
    "db:reset": "bun run scripts/db/reset.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "dev:renderer": "vite",
    "build": "tsc --noEmit && electron-forge package",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip --no-progress",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run test && bun run check:proof",
    "check:proof": "bunx vite-node --config vitest.config.ts scripts/test/prove-trade-loop.ts --mode=mock",
    "prove": "bunx vite-node --config vitest.config.ts scripts/test/prove-trade-loop.ts",
    "headless": "bash scripts/headless/run.sh",
    "db:backup": "bash scripts/db/backup.sh",
    "test": "vitest run",
    "cert:broker": "bun run scripts/broker/cert-broker.ts",
    "acceptance:report": "bun run scripts/acceptance/one-day-report.ts",
    "test:smoke": "bun run scripts/test/smoke-critical-path.ts",
    "test:smoke:critical": "bun run scripts/test/smoke-critical-path.ts --critical-only",
    "test:watch": "vitest",
    "backtest:edgar": "bun run scripts/research/run-edgar-backtest.ts",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "doctor": "react-doctor",
    "doctor:scan": "bunx react-doctor . --verbose",
    "doctor:fix:safe": "bun run scripts/tooling/react-doctor-fix.ts --safe",
    "doctor:fix:safe:dry": "bun run scripts/tooling/react-doctor-fix.ts --safe --dry-run",
    "doctor:fix:tiny-text": "bun run scripts/tooling/react-doctor-fix.ts --rule no-tiny-text",
    "logs:clear": "rm -f \"$HOME/.exva/logs\"/*.log",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .vite",
    "clean:everything": "bun run clean && bun run logs:clear && bun install && bun run db:reset && bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/provider-utils": "3.0.23",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-sans": "^5.2.8",
    "@polymarket/clob-client": "^5.8.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.100.9",
    "ai": "^5.0.0",
    "better-sqlite3": "^11.7.0",
    "bufferutil": "^4.1.0",
    "ccxt": "^4.5.51",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "electron-squirrel-startup": "^1.0.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.461.0",
    "mermaid": "^11.15.0",
    "p-queue": "^8.1.0",
    "pino": "^9.5.0",
    "protobufjs": "^8.0.3",
    "react": "^18.3.1",
    "react-doctor": "^0.1.6",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "utf-8-validate": "^6.0.6",
    "viem": "2.48.8",
    "ws": "^8.21.0",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron-forge/shared-types": "7.11.1",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.30.1",
    "electron": "^33.2.1",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^15.5.1",
    "postcss": "^8.4.49",
    "postcss-load-config": "6.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
