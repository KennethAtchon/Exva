{
  "name": "exva",
  "productName": "Exva",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop app that runs paper-trading bots on Alpaca and shows why every bot did or didn't trade.",
  "main": "desktop/dist/main.js",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "exva": "bun engine/src/cli.ts",
    "engine": "bun engine/src/cli.ts run",
    "demo": "bun engine/src/cli.ts run --demo",
    "dev:engine": "bun --watch engine/src/cli.ts run",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:desktop": "bun build desktop/src/main.ts --outdir desktop/dist --target node --format esm --external electron",
    "start": "bun run build:ui && bun run build:desktop && electron .",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test engine shared scripts",
    "test:e2e": "playwright test --config ui/e2e/playwright.config.ts",
    "budget": "bun scripts/budget.ts",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run budget && bun run build:ui"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
